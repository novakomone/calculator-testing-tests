
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Calculator Test Suite"
       parallel="classes"
       thread-count="4">

    <test name="Calculator Tests">
        <groups>
            <run>
                <include name="arithmetic"/>
                <include name="math"/>
                <include name="trigonometry"/>
                <include name="validation"/>
            </run>
        </groups>

        <packages>
            <package name="com.epam.calculator.tests"/>
        </packages>
    </test>

</suite>
